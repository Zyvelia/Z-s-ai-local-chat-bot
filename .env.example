# Copy to .env; NEVER commit real production credentials.
POSTGRES_PASSWORD=choose_a_strong_local_password
JWT_SECRET=replace_with_a_long_random_32_plus_character_secret
OLLAMA_MODEL=llama3.2:3b
INFERENCE_CONCURRENCY=2
INFERENCE_WAIT_SECONDS=20
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# v1.4 voice (self-hosted): do not expose the internal voice port.
VOICE_INTERNAL_TOKEN=local-dev-voice-token-change-me
VOICE_IDS=default
WHISPER_MODEL=tiny

# v1.7 Redis-backed coordination and bounded resources (compose wires REDIS_URL)
INFERENCE_LEASE_SECONDS=120
INFERENCE_MAX_WAITERS=100
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=15
OLLAMA_CACHE_TTL_SECONDS=15
INFERENCE_MAX_CONTEXT=16384
INFERENCE_MAX_OUTPUT=2048
